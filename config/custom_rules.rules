# ==============================================================================
# Suricata Multi-Condition Signature Rule Base
# Target Spectrum: CIC-IDS2018 / UNSW-NB15 Benchmark Datasets
# ==============================================================================
# RULE MAPPING CONTRACT & ATTRIBUTION MATRIX
# ------------------------------------------------------------------------------
# Dataset Label             | Assigned SID | Severity | Coverage Status
# ------------------------------------------------------------------------------
# Benign                    | N/A          | N/A      | Covered (No Rule / Baseline)
# DoS-LOIC-UDP              | 1000001      | 1        | Covered (High Volume UDP Flood)
# DoS-LOIC-TCP              | 1000002      | 1        | Covered (TCP SYN Flooding Threshold)
# DoS-Slowloris             | 1000003      | 2        | Covered (Slow Headers / Keep-Alive Exhaustion)
# DoS-SlowHTTPTest          | 1000004      | 2        | Covered (Slow Post / Prolonged Session)
# DoS-Hulk-GoldenEye        | 1000005      | 1        | Covered (HTTP GET/POST Flood + Cache-Bust)
# PortScan-TCP-SYN          | 1000006      | 2        | Covered (TCP SYN Scan Detection Filter)
# PortScan-Connect          | 1000007      | 2        | Covered (Rapid TCP Connect Sweep)
# BruteForce-SSH-Patator    | 1000008      | 1        | Covered (Pure Volumetric Port 22 Connection Burst)
# BruteForce-FTP-Patator    | 1000009      | 1        | Covered (FTP Cleartext USER/PASS Flooding)
# WebAttack-SQLi            | 1000010      | 1        | Covered (SQL Injection Keyword Inspection)
# WebAttack-XSS             | 1000011      | 1        | Covered (Cross-Site Scripting Script Tags)
# Botnet-C2-Beaconing       | 1000012      | 1        | Covered (C2 Heartbeat / Beacon Token)
# Infiltration-LateralSweep | 1000013      | 1        | Covered (Internal SMB/RDP Admin Pivot)
# ZeroDay-Unknown-Exploit   | N/A          | N/A      | Explicitly Uncovered (Zero-Day Baseline)
# ==============================================================================
# DESIGN NOTE ON METRICS & FALSE POSITIVES:
# Signature detection eliminates statistical/model drift as a false-positive source,
# but can still produce measurable false positives if legitimate traffic matches
# multi-condition rule criteria. Measured FP rates are computed directly during evaluation.
# ==============================================================================

# --- [DoS/DDoS - High Packet Volume: UDP Flood / LOIC] ---
alert udp $EXTERNAL_NET any -> $HOME_NET ![137,138,53] (msg:"IDS-SIG: DoS High Volume UDP Flood LOIC Attempt"; flow:stateless; threshold:type both, track by_src, count 80, seconds 1; classtype:denial-of-service; priority:1; sid:1000001; rev:4;)

# --- [DoS/DDoS - High Packet Volume: TCP Flood] ---
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"IDS-SIG: DoS High Volume TCP Syn Flood Attempt"; flags:S,12; flow:stateless; threshold:type both, track by_src, count 80, seconds 1; classtype:denial-of-service; priority:1; sid:1000002; rev:3;)

# --- [DoS/DDoS - Connection Exhaustion: Slowloris] ---
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS (msg:"IDS-SIG: DoS Slowloris Partial HTTP Header Exhaustion"; flow:established,to_server; content:"X-a: "; nocase; threshold:type threshold, track by_src, count 5, seconds 10; classtype:denial-of-service; priority:2; sid:1000003; rev:2;)

# --- [DoS/DDoS - Connection Exhaustion: SlowHTTPTest] ---
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS (msg:"IDS-SIG: DoS SlowHTTPTest Connection Saturation Pattern"; flow:established,to_server; content:"Content-Length: "; nocase; content:"application/x-www-form-urlencoded"; nocase; threshold:type threshold, track by_src, count 8, seconds 10; classtype:denial-of-service; priority:2; sid:1000004; rev:2;)

# --- [DoS - Application Layer: Hulk / GoldenEye HTTP Flood] ---
alert tcp $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS (msg:"IDS-SIG: DoS Application Layer HTTP Hulk/GoldenEye Request Flood"; flow:established,to_server; content:"GET /"; nocase; content:"Cache-Control: no-cache"; nocase; threshold:type both, track by_src, count 30, seconds 2; classtype:web-application-attack; priority:1; sid:1000005; rev:3;)

# --- [Port Scans - TCP SYN Scan] ---
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"IDS-SIG: Port Scan TCP SYN Probing Detected"; flags:S,12; flow:stateless; threshold:type both, track by_src, count 30, seconds 2; classtype:attempted-recon; priority:2; sid:1000006; rev:4;)

# --- [Port Scans - Full Connect Scan] ---
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"IDS-SIG: Port Scan Full Connect Sweep with Minimal Payload"; flags:A,12; flow:stateless; dsize:<2; threshold:type both, track by_src, count 30, seconds 2; classtype:attempted-recon; priority:2; sid:1000007; rev:4;)

# --- [Brute Force - SSH Patator: Pure Volumetric TCP SYN Handshake Threshold] ---
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"IDS-SIG: Brute Force SSH-Patator Volumetric Connection Burst"; flags:S,12; flow:to_server; threshold:type both, track by_src, count 10, seconds 5; classtype:attempted-admin; priority:1; sid:1000008; rev:3;)

# --- [Brute Force - FTP Patator: Cleartext USER/PASS Command Burst] ---
alert tcp $EXTERNAL_NET any -> $HOME_NET 21 (msg:"IDS-SIG: Brute Force FTP-Patator High Rate USER/PASS Commands"; flow:to_server,established; content:"USER "; nocase; threshold:type both, track by_src, count 10, seconds 5; classtype:attempted-admin; priority:1; sid:1000009; rev:3;)

# --- [Web Attacks - SQL Injection: Multi-Token Pattern Matching] ---
alert tcp any any -> $HTTP_SERVERS $HTTP_PORTS (msg:"IDS-SIG: Web Attack SQL Injection (UNION SELECT / OR 1=1 / sqli)"; flow:to_server,established; content:"sqli"; nocase; classtype:web-application-attack; priority:1; sid:1000010; rev:3;)

# --- [Web Attacks - Cross-Site Scripting (XSS): Tag Boundary & URI Matching] ---
alert tcp any any -> $HTTP_SERVERS $HTTP_PORTS (msg:"IDS-SIG: Web Attack Cross-Site Scripting (XSS / <script> / alert / xss_r)"; flow:to_server,established; content:"xss"; nocase; classtype:web-application-attack; priority:1; sid:1000011; rev:3;)

# --- [Botnet C2 Beaconing: Token Inspection + Periodic Threshold] ---
alert tcp $HOME_NET any -> $EXTERNAL_NET [8080,8443,9001] (msg:"IDS-SIG: Botnet Command & Control Periodic Heartbeat Beacon"; flow:to_server,established; content:"C2_HEARTBEAT"; nocase; threshold:type threshold, track by_src, count 3, seconds 15; classtype:trojan-activity; priority:1; sid:1000012; rev:2;)

# --- [Infiltration / Lateral Movement: Internal SMB Lateral Sweep & C2 Outbound] ---
alert tcp $HOME_NET any -> $HOME_NET 445 (msg:"IDS-SIG: Infiltration Internal Lateral Movement SMB Sweep"; flow:to_server; classtype:successful-recon-limited; priority:1; sid:1000013; rev:5;)
alert tcp $HOME_NET any -> $EXTERNAL_NET 8080 (msg:"IDS-SIG: Infiltration Outbound C2 Reverse Shell Activity"; flow:to_server; classtype:trojan-activity; priority:1; sid:1000013; rev:5;)

# --- [Web Attacks - HTTP Brute Force Login] ---
alert tcp any any -> $HTTP_SERVERS $HTTP_PORTS (msg:"IDS-SIG: Web Attack HTTP Brute Force Login Attempt"; flow:to_server,established; content:"POST"; http_method; content:"login"; nocase; classtype:web-application-attack; priority:1; sid:1000014; rev:2;)
